{
  "manifest_version": 3,
  "name": "Bahamut (動畫瘋) Cookie Pusher",
  "version": "1.0.0",
  "description": "一鍵把目前登入動畫瘋的 cookie 推到你的 anigamer-based 後台,熱更新觀看歷史同步。後台網址可自行設定。",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://*.gamer.com.tw/*",
    "https://gamer.com.tw/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "推送動畫瘋 cookie"
  }
}
