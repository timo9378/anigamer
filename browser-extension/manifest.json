{
  "manifest_version": 3,
  "name": "Bahamut (動畫瘋) Cookie Pusher",
  "version": "1.3.0",
  "description": "一鍵把登入動畫瘋的 cookie 推到你的 anigamer-based 後台,並即時回報「正在看哪部動畫」。後台網址可自行設定。",
  "permissions": ["cookies", "storage", "debugger"],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://ani.gamer.com.tw/animeVideo.php*"],
      "js": ["scrobble-bahamut.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "推送動畫瘋 cookie"
  }
}
