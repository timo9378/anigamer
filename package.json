{
  "name": "anigamer",
  "version": "0.2.0",
  "description": "Unofficial SDK for ani.gamer.com.tw (bahamut animation) — user data: watch history, cover URLs, cookie auto-rotation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node tests/integration/real-api.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "prepublishOnly": "pnpm verify"
  },
  "keywords": [
    "bahamut",
    "anigamer",
    "ani-gamer",
    "anime",
    "sdk",
    "watch-history"
  ],
  "author": "timo9378 <timo9378@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timo9378/anigamer.git"
  },
  "bugs": {
    "url": "https://github.com/timo9378/anigamer/issues"
  },
  "homepage": "https://github.com/timo9378/anigamer#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@9.0.0"
}
